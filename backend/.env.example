# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas: Cluster > Connect > Drivers
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/oddspot?retryWrites=true&w=majority

# Server
PORT=5001
FRONTEND_URL=http://localhost:5173

# Auth (must be at least 32 characters long)
JWT_SECRET=use-at-least-32-characters-random-secret-key-here
# Optional key rotation keyring and current kid
# JWT_SECRETS={"k1":"secret-at-least-32-characters-long-k1","k2":"secret-at-least-32-characters-long-k2"}
# JWT_CURRENT_KEY_ID=k2
# Mail transport (console for dev/test)
# MAIL_TRANSPORT=console

# Location Fuzzing Secret (required >= 32 characters in production)
FUZZ_SECRET=use-at-least-32-characters-fuzz-secret-here
# LOCATION_FUZZ_SALT=use-at-least-32-characters-fuzz-secret-here (legacy alias)

# Meter & Moderation Thresholds (optional overrides)
METER_COUNTRY_THRESHOLD=50
REPORT_FUZZ_THRESHOLD=3

# Non-production Rate Limit Overrides (only active when NODE_ENV !== 'production'; strictly ignored in production)
# In production, strict defaults are enforced:
# Auth: 20 per 15 min | Create Post: 30 per hour | Votes: 120 per 15 min | Comments: 60 per 15 min | Reports: 20 per 15 min
# AUTH_RATE_LIMIT_MAX=10000
# WRITE_RATE_LIMIT_MAX=10000

# Image hosting & upload provider (allowlist | cloudinary | r2)
# Default is 'allowlist' (zero keys required, uses allowlisted HTTPS image URLs)
UPLOAD_PROVIDER=allowlist
# Optional host allowlist for post and visit image URLs (comma-separated domains)
# IMAGE_HOST_ALLOWLIST=res.cloudinary.com,images.unsplash.com
# Cloudinary credentials (required if UPLOAD_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Cloudflare R2 / S3 credentials (required if UPLOAD_PROVIDER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=