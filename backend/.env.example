# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas: Cluster > Connect > Drivers
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/oddspot?retryWrites=true&w=majority

# Server
PORT=5001
FRONTEND_URL=http://localhost:5173

# Auth (use a long random string)
JWT_SECRET=change-me

# Meter & Moderation Thresholds (optional overrides)
METER_COUNTRY_THRESHOLD=50
REPORT_FUZZ_THRESHOLD=3

# Non-production Rate Limit Overrides (ignored in production)
# AUTH_RATE_LIMIT_MAX=20
# WRITE_RATE_LIMIT_MAX=100

# Image hosting (fill in once you pick Cloudinary or R2)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=